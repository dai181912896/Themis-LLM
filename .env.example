# Themis LLM Configuration
# Copy this file to .env and fill in your API keys

# Volcengine Ark API (primary LLM + embedding)
ARK_API_KEY=your_ark_api_key_here
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/coding/v3
ARK_MODEL=ark-code-latest
ARK_EMBEDDING_MODEL=doubao-embedding-vision

# Zilliz/Milvus (Kill Chain Knowledge Base)
ZILLIZ_TOKEN=your_zilliz_token_here

# Optional: Tencent LKEAP (legacy embedding, if Ark unavailable)
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
